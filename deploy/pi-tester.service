[Unit]
Description=Pi Test Host (GPIO, PWM, I2C, UART, Redfish web API)
After=network.target

[Service]
# root: GPIO, PWM sysfs, /dev/i2c-*, port 80 and writing netplan
# venv with the anthropic SDK, see install.sh
ExecStart=/opt/pi-tester-venv/bin/python -m pi_tester
WorkingDirectory=/opt/pi-tester
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
